generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String      @id @default(cuid())
  name         String
  email        String      @unique
  passwordHash String
  createdAt    DateTime    @default(now())
  interviews   Interview[]
}

model Role {
  id            String      @id @default(cuid())
  slug          String      @unique
  nameEn        String
  nameAr        String
  descriptionEn String
  descriptionAr String
  focusAreas    String[]
  /// "education" roles get a school-principal interviewer; others a hiring manager from the field.
  domain        String      @default("education")
  sortOrder     Int         @default(0)
  interviews    Interview[]
}

enum InterviewStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

model Interview {
  id             String          @id @default(cuid())
  userId         String
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Set when the student picked a suggested role; null for a custom role.
  roleId         String?
  role           Role?           @relation(fields: [roleId], references: [id])
  /// The role exactly as the student typed it (custom roles). Shown everywhere instead of a generic label.
  roleTitle      String?
  /// Optional free-form specialization / subject (e.g. "Mathematics", "Backend / Java", "NLP / RAG").
  specialization String?
  language       String // "en" | "ar": the preferred / starting language
  languageMode   String          @default("fixed") // "fixed" | "smart" (interviewer follows the student's language)
  difficulty     String // "beginner" | "intermediate" | "advanced"
  length         String // "quick" | "standard" | "full"
  maxQuestions   Int
  jobDescription String?
  /// Short candidate profile condensed from an uploaded CV (no contact details). The CV file itself is never stored.
  cvProfile      String?
  topics         String[]
  status         InterviewStatus @default(IN_PROGRESS)
  isMock         Boolean         @default(false)
  overallScore   Int?
  startedAt      DateTime        @default(now())
  endedAt        DateTime?
  durationSec    Int?
  questions      Question[]
  report         Report?

  @@index([userId, startedAt])
}

model Question {
  id          String    @id @default(cuid())
  interviewId String
  interview   Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  order       Int
  text        String
  language    String? // language this question was asked in: "ar" | "en" | "mixed"
  kind        String // "MAIN" | "FOLLOW_UP"
  topic       String?
  createdAt   DateTime  @default(now())
  answer      Answer?

  @@unique([interviewId, order])
}

// An answer and its per-answer evaluation.
model Answer {
  id                   String   @id @default(cuid())
  questionId           String   @unique
  question             Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  transcript           String
  durationSec          Int?
  relevance            Int
  clarity              Int
  communication        Int
  subjectKnowledge     Int
  educationalReasoning Int
  score                Int // 0-100, derived from the five criteria
  feedback             String
  suggestedAnswer      String
  createdAt            DateTime @default(now())
}

model Report {
  id              String    @id @default(cuid())
  interviewId     String    @unique
  interview       Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  overallScore    Int
  /// Language all report text is written in ("ar" | "en").
  language        String?
  categoryScores  Json
  strengths       String[]
  improvements    String[]
  practiceAreas   String[]
  generalFeedback String
  createdAt       DateTime  @default(now())
}
