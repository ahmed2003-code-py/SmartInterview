# Server (Railway sets PORT automatically)
PORT=4000
NODE_ENV=development
JWT_SECRET=change-me-to-a-long-random-string
DATABASE_URL=postgresql://interview:interview@localhost:5436/interview_sim

# Demo mode: true = no external AI calls (predefined questions, simulated transcripts, rule-based scoring)
MOCK_AI=true

# Groq (speech-to-text + LLM). Keep this secret; it is only used by the backend.
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3-turbo
LLM_MODEL=openai/gpt-oss-120b

# Create the demo account (demo@smartinterview.app / demo1234) on startup if it doesn't exist
SEED_DEMO_ACCOUNT=false
