# Server
PORT=4000
NODE_ENV=development
JWT_SECRET=change-me-to-a-long-random-string
DATABASE_URL=postgresql://interview:interview@localhost:5436/interview_sim

# Demo mode: true = no external AI calls (predefined questions, simulated transcripts, rule-based scoring)
MOCK_AI=true

# Speech-to-text provider: groq | cohere | mock
STT_PROVIDER=groq
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3-turbo

# Optional: self-hosted Cohere Transcribe Arabic via vLLM (OpenAI-compatible endpoint)
COHERE_STT_URL=http://localhost:8000/v1/audio/transcriptions
COHERE_STT_MODEL=CohereLabs/cohere-transcribe-arabic-07-2026
COHERE_STT_API_KEY=

# LLM (any OpenAI-compatible chat completions API). Defaults to Groq.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
